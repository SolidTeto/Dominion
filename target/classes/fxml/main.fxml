<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import fr.umontpellier.iut.dominionfx.views.CurrentPlayerView?>
<?import fr.umontpellier.iut.dominionfx.views.OtherPlayersView?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<fx:root type="StackPane" stylesheets="@../css/style.css"
         xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <BorderPane>
          <top>
              <FlowPane fx:id="cardsInPile" alignment="CENTER" hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER" />
          </top>
          <center>
            <VBox id="gameView" fx:id="gameView" BorderPane.alignment="CENTER" alignment="CENTER">
                <CurrentPlayerView fx:id="currentPlayerView"/>
                <ImageView fx:id="skip">
                    <Image url="@../images/Skip.png"/>
                </ImageView>
            </VBox>
          </center>
          <right>
              <VBox fx:id="right" StackPane.alignment="CENTER_RIGHT" alignment="CENTER_RIGHT"/>
          </right>
          <left>
              <FlowPane fx:id="temporayCards" BorderPane.alignment="CENTER" alignment="CENTER" hgap="10" vgap="10" managed="false"/>
          </left>
          <bottom>
              <OtherPlayersView fx:id="othersPlayersView"/>
          </bottom>
      </BorderPane>
   </children>
</fx:root>
