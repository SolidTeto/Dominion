<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root stylesheets="@../css/style.css" type="BorderPane" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <ImageView fx:id="titre" BorderPane.alignment="CENTER">
            <image>
                <Image url="@../images/title.png" />
            </image>
         <BorderPane.margin>
            <Insets bottom="50.0" />
         </BorderPane.margin>
        </ImageView>
    </top>
    <center>
      <StackPane alignment="TOP_CENTER" BorderPane.alignment="TOP_CENTER">
         <children>
            <VBox fx:id="bob" stylesheets="@../css/styleChoosePlayer.css">
                <HBox fx:id="hbox" alignment="CENTER">
                </HBox>
                <VBox fx:id="vbox" alignment="CENTER" spacing="20.0">
                  <VBox.margin>
                     <Insets top="75.0" />
                  </VBox.margin>
                </VBox>
                <ImageView fx:id="button" fitHeight="48.0" fitWidth="148.0">
                    <VBox.margin>
                        <Insets top="50.0"/>
                    </VBox.margin>
                    <Image url="@../images/start.png"/>
                </ImageView>
            </VBox>
         </children>
      </StackPane>
   </center>
</fx:root>
